.DS_Store
*.pyc
*.egg-info
*.swp
__pycache__
dev-dist
tags
node_modules
crm/public/frontend
crm/www/crm.html
build

.vscode

# ------------------------------------------------------------------
# Frappe bench runtime / generated files (not source — safe to ignore)
# ------------------------------------------------------------------

# Logs
*.log
*.log.*
frappe-bench/logs/
frappe-bench/sites/*/logs/
nohup.out
frappe-bench/nohup.out
frappe-bench/server.log

# Process state, pids, redis dumps
*.pid
*.rdb
frappe-bench/config/pids/

# Python virtualenv
frappe-bench/env/

# Site runtime data (locks, search indexes, backups, user uploads)
frappe-bench/sites/*/locks/
frappe-bench/sites/*/indexes/
frappe-bench/sites/*/private/backups/
frappe-bench/sites/*/private/files/
frappe-bench/sites/*/public/files/

# Built assets (regenerated by `bench build`)
frappe-bench/sites/assets/

# Backed-up / renamed site dirs
frappe-bench/sites/*.bak/
frappe-bench/sites/*.expired/
